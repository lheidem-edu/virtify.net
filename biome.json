{
    "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
    "files": {
        "includes": [
            "**",
            "!.next",
            "!.claude",
            "!node_modules",
            "!tsconfig.tsbuildinfo",
            "!next-env.d.ts",
            "!drizzle",
            "!public/openapi.json",
            "!components.json"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "overrides": [
        {
            "includes": ["src/components/ui/**", "src/hooks/use-mobile.ts"],
            "linter": {
                "enabled": false
            },
            "formatter": {
                "enabled": false
            },
            "assist": {
                "actions": {
                    "source": {
                        "organizeImports": "off"
                    }
                }
            }
        }
    ]
}
