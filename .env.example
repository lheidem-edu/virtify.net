# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string. `npm run db:up` starts a local container and
# prints the value to use here. In production this points at the Postgres
# container managed by Dokploy.
DATABASE_URL=

# `npm start` applies pending migrations before the server binds, so a
# container never serves traffic against an unexpected schema. It fails hard
# if this is unset or the database is unreachable. The image must therefore
# contain the drizzle/ directory — it holds the migration SQL and the journal.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Public origin of the deployment. Verification and password-reset links are
# built from it, so a wrong value produces links that go nowhere.
BETTER_AUTH_URL=https://virtify.net

# Signing key for sessions and tokens. Generate with:
#   openssl rand -base64 32
# Changing it invalidates every session and every pending verification link.
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Secrets at rest
# ---------------------------------------------------------------------------
# AES-256-GCM key for everything the panel has to keep usable rather than only
# verify: payment-gateway credentials, server API tokens, Microsoft Graph
# secrets, provisioned service passwords. Generate with:
#   openssl rand -base64 32
# Losing it makes those columns unreadable; rotating it is a two-step move —
# put the new key here, the old one in APP_ENCRYPTION_KEY_OLD, let the rotation
# script re-encrypt, then drop the old key.
APP_ENCRYPTION_KEY=

# Retired keys during a rotation, comma-separated. They still decrypt; only the
# key above encrypts.
APP_ENCRYPTION_KEY_OLD=

# ---------------------------------------------------------------------------
# Documents
# ---------------------------------------------------------------------------
# Where the rendered invoice and credit note PDFs are kept. A finalized
# invoice has to come back byte for byte years later, so this directory is
# part of the data, not of the build: mount it as a volume, or a redeploy
# takes every stored document with it. Relative paths are resolved against
# the working directory. The default is .data/documents.
#
# The store sits behind an interface (src/server/storage) — an S3-compatible
# backend plugs in there without anything above it changing.
DOCUMENT_STORAGE_PATH=.data/documents

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Relay used for outbound mail: cancellations and their receipts, plus
# account verification and password resets. Port 25, no authentication — an
# internal relay that accepts mail from this server by address.
#
# This must be a relay that can send to ARBITRARY recipients. A Microsoft 365
# endpoint (*.mail.protection.outlook.com, *.mx.microsoft) is one tenant's
# inbound MX: it accepts mail only for that tenant's own mailboxes and refuses
# to relay anywhere else, so customer mail would never go out.
#
# Two further requirements for outbound mail to be accepted by recipients:
#   - the relay's IP needs a reverse DNS (PTR) record
#   - that IP must be covered by the SPF record of virtify.net
#
# Connections are currently forced to IPv4, because recipients such as
# Microsoft 365 reject mail from an IPv6 address without reverse DNS. Once
# the sending host's IPv6 address has a PTR record, drop `family: 4` from
# src/lib/mail.ts and scripts/mail-check.mjs.
#
# Verify the whole path with:  npm run mail:check -- you@example.com
VIRTIFY_SMTP_HOST=

# The name this server gives in EHLO. Left unset, nodemailer sends the
# machine's own hostname and falls back to 127.0.0.1 when that is not a name
# the outside world knows — a greeting recipients such as Microsoft 365 score
# against you. Set the server's public address, or a name that resolves back
# to it. A bare address is turned into an RFC 5321 address literal, so write
# it plainly:  118.91.184.85
VIRTIFY_SMTP_EHLO=

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
# Overrides the commit shown in the footer. Set this in container builds,
# where no .git directory is present.
# GIT_COMMIT_SHA=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Both providers are optional: without keys the pay buttons do not appear and
# everything else keeps working. Invoices remain payable by bank transfer,
# which is a gateway of its own and is on by default.
#
# Everything below is a FALLBACK. The operator can store the same credentials
# in /admin/settings/payments, where they are encrypted at rest with
# APP_ENCRYPTION_KEY (hard rule 6) and a row there wins over this file. Keep
# the keys here for development; use the admin area in production.
#
# Stripe is also the rail for recurring collection — the customer stores a
# payment method once and we charge it when an invoice is issued, so our own
# invoice number and XRechnung stay the record. Two dashboard settings matter:
#   - Settings > Business > Customer emails > Payments: turn receipts OFF,
#     they would compete with our invoices
#   - Stripe Tax stays off. § 19 UStG means no tax is ever shown.
STRIPE_SECRET_KEY=
# Signing secret of the endpoint https://virtify.net/api/webhooks/stripe.
# Subscribe it to: checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# payment_intent.succeeded, payment_intent.processing, payment_intent.payment_failed,
# setup_intent.succeeded, setup_intent.setup_failed, charge.refunded,
# charge.dispute.created, charge.dispute.updated, charge.dispute.closed.
# Locally: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# PayPal, from an app in the developer dashboard. Sandbox and live are
# different apps with different credentials and a different webhook id.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id of the webhook listener for https://virtify.net/api/webhooks/paypal,
# subscribed to PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED,
# PAYMENT.CAPTURE.DECLINED, PAYMENT.CAPTURE.REFUNDED, PAYMENT.CAPTURE.REVERSED,
# CHECKOUT.ORDER.APPROVED and — if the subscriptions recurring mode is used —
# PAYMENT.SALE.COMPLETED. PayPal has no shared signing secret; without this id
# webhooks cannot be authenticated at all and are rejected.
PAYPAL_WEBHOOK_ID=

# Charging a stored PayPal wallet needs "reference transactions", which PayPal
# enables per account only on request — sandbox accounts have it, live ones do
# not by default. Leave this off until PayPal has confirmed the approval in
# writing, or the customer meets MERCHANT_NOT_ENABLED_FOR_REFERENCE_TRANSACTION
# after already authorising. Recurring collection through Stripe is unaffected.
#
# This only picks the DEFAULT recurring mode: off means PayPal's own
# Subscriptions API runs the schedule and its PAYMENT.SALE.COMPLETED events are
# mapped onto our invoices; on means a stored wallet is charged like a card.
# /admin/settings/payments overrides it per installation.
PAYPAL_VAULTING_ENABLED=false
