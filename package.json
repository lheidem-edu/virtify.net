{
    "name": "virtify.net",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "next build --turbopack",
        "db:down": "node scripts/db.mjs down",
        "db:generate": "drizzle-kit generate",
        "db:logs": "node scripts/db.mjs logs",
        "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
        "db:reset": "node scripts/db.mjs reset",
        "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
        "db:up": "node scripts/db.mjs up",
        "dev": "next dev --turbopack",
        "legal:export": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/legal-export.mts",
        "lint": "biome lint",
        "mail:check": "node --env-file-if-exists=.env.local scripts/mail-check.mjs",
        "staff:add": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/staff-add.mts",
        "start": "node scripts/migrate.mjs && next start"
    },
    "dependencies": {
        "@base-ui/react": "1.8.0",
        "@react-pdf/renderer": "4.9.0",
        "@tanstack/react-table": "8.21.3",
        "better-auth": "1.7.3",
        "class-variance-authority": "0.7.1",
        "cn": "0.2.5",
        "drizzle-orm": "0.45.2",
        "lucide-react": "1.41.0",
        "next": "16.3.4",
        "nodemailer": "10.0.0",
        "pg": "8.23.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "server-only": "0.0.1",
        "stripe": "22.6.1",
        "ulid": "3.0.2"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.12",
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "26.4.1",
        "@types/nodemailer": "8.0.1",
        "@types/pg": "8.23.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "drizzle-kit": "0.31.10",
        "shadcn": "4.21.0",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "typescript": "7.0.2"
    }
}
