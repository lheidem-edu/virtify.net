                    },
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "description": "Der Rechnungsempfänger. Pflichtangabe beim Anlegen eines Kontos.",
                        "example": "Maria Musterfrau"
                    },
                    "company": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 200,
                        "description": "Firmenname, falls vorhanden.",
                        "example": "Beispiel GmbH"
                    },
                    "street": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 200,
                        "description": "Straße und Hausnummer.",
                        "example": "Musterweg 3"
                    },
                    "postal_code": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 32,
                        "description": "Postleitzahl.",
                        "example": "48145"
                    },
                    "city": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 200,
                        "description": "Ort.",
                        "example": "Münster"
                    },
                    "country": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "pattern": "^[A-Za-z]{2}$",
                        "description": "Ländercode nach ISO 3166-1 alpha-2.",
                        "example": "DE"
                    },
                    "vat_id": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 32,
                        "description": "Umsatzsteuer-Identifikationsnummer. Wird beim Speichern nicht geprüft.",
                        "example": "DE123456789"
                    },
                    "phone": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 64,
                        "description": "Telefonnummer für Rückfragen.",
                        "example": "+49 251 1234567"
                    },
                    "buyer_reference": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 200,
                        "description": "Käuferreferenz nach EN 16931 (BT-10).",
                        "example": "04011000-12345-67"
                    },
                    "language": {
                        "type": "string",
                        "enum": [
                            "de",
                            "en"
                        ],
                        "description": "Sprache für Dokumente und E-Mails.",
                        "example": "de"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "active",
                            "suspended",
                            "closed"
                        ],
                        "description": "`active` im Regelfall, `suspended` wenn Leistungen gesperrt sind, `closed` für beendete Konten.",
                        "example": "active"
                    },
                    "notes": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 5000,
                        "description": "Interne Notiz, nur für die Verwaltung.",
                        "example": "Rechnung bitte per Post."
                    }
                },
                "required": [
                    "name"
                ],
                "description": "Ein neues Kundenkonto. Die Kundennummer wird vergeben, nicht übergeben."
            },
            "CustomerPatch": {
                "type": "object",
                "properties": {
                    "kind": {
                        "type": "string",
                        "enum": [
                            "company",
                            "private"
                        ],
                        "description": "`company` für eine Firma, `private` für eine Privatperson. Entscheidet über Widerrufsrecht und, sobald die Regelbesteuerung aktiv ist, über die Umsatzsteuer.",
                        "example": "company"
                    },
                    "name": {
                        "type": "string",
