    "paths": {
        "/api/v1/customers": {
            "get": {
                "tags": [
                    "Kunden"
                ],
                "summary": "Kundenkonten auflisten",
                "description": "Gibt die Kundenkonten seitenweise zurück, sortiert nach ID. Ein Verwaltungsschlüssel mit `customers.read` sieht alle Konten und kann über `q` nach Nummer, Name, Firma oder der Adresse eines Kontakts suchen; ein Kundenschlüssel sieht ausschließlich sein eigenes Konto.",
                "security": [
                    {
                        "ApiKey": []
                    }
                ],
                "parameters": [
                    {
                        "schema": {
                            "type": "string",
                            "description": "`next_cursor` der vorherigen Seite. Fehlt er, beginnt die Liste am Anfang.",
                            "example": "invoice_01K9ZC4X7QG0VN3M8T6B2PFHRD"
                        },
                        "required": false,
                        "description": "`next_cursor` der vorherigen Seite. Fehlt er, beginnt die Liste am Anfang.",
                        "name": "cursor",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100,
                            "default": 25,
                            "description": "Zeilen pro Seite, höchstens 100.",
                            "example": 25
                        },
                        "required": false,
                        "description": "Zeilen pro Seite, höchstens 100.",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "string",
                            "description": "Suchbegriff über Kundennummer, Name, Firma und Kontaktadressen.",
                            "example": "Beispiel GmbH"
                        },
                        "required": false,
                        "description": "Suchbegriff über Kundennummer, Name, Firma und Kontaktadressen.",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "schema": {
                            "type": "string",
                            "enum": [
                                "active",
                                "suspended",
                                "closed"
                            ],
                            "description": "Auf einen Kontostatus einschränken.",
                            "example": "active"
                        },
                        "required": false,
                        "description": "Auf einen Kontostatus einschränken.",
                        "name": "status",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Eine Seite Kundenkonten.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CustomerPage"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Die Anfrage war syntaktisch falsch.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Kein oder kein gültiger API-Schlüssel.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Der Schlüssel darf das nicht.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Nicht vorhanden — oder nicht für diesen Schlüssel.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Die Eingabe hat die Prüfung nicht bestanden.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Kunden"
                ],
                "summary": "Kundenkonto anlegen",
                "description": "Legt ein Kundenkonto ohne Login an — für die Übernahme von Bestandskunden und für Konten, die die Verwaltung selbst führt. Die Kundennummer kommt aus demselben lückenlosen Zähler wie bei einer Registrierung. Benötigt `customers.write`; Kundenschlüssel dürfen das nicht.",
                "security": [
                    {
                        "ApiKey": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CustomerCreate"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Das angelegte Konto.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Customer"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Die Anfrage war syntaktisch falsch.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Kein oder kein gültiger API-Schlüssel.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Der Schlüssel darf das nicht.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Nicht vorhanden — oder nicht für diesen Schlüssel.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Die Eingabe hat die Prüfung nicht bestanden.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/customers/{id}": {
            "get": {
                "tags": [
                    "Kunden"
                ],
                "summary": "Kundenkonto ansehen",
                "description": "Ein einzelnes Kundenkonto. Ein Kundenschlüssel darf nur sein eigenes abfragen und erhält für jedes andere 404 — nicht 403, was die Existenz eines fremden Kontos bestätigen würde.",
                "security": [
                    {
                        "ApiKey": []
                    }
                ],
                "parameters": [
                    {
                        "schema": {
                            "type": "string",
                            "description": "Die technische ID des Kundenkontos.",
                            "example": "customer_01K9ZC4X7QG0VN3M8T6B2PFHRD"
                        },
                        "required": true,
                        "description": "Die technische ID des Kundenkontos.",
                        "name": "id",
                        "in": "path"
                    }
                ],
                "responses": {
