{
    "openapi": "3.1.0",
    "info": {
        "title": "virtify.net API",
        "version": "0.1.0",
        "description": "Die REST-Schnittstelle des Abrechnungsportals von **virtify.net**.\n\n## Authentifizierung\n\nJede Anfrage trägt einen API-Schlüssel im Kopf:\n\n```\nAuthorization: Bearer vfy_…\n```\n\nSchlüssel werden im Kunden- oder Verwaltungsbereich erzeugt, genau einmal\nangezeigt und nur als Hash gespeichert. Ein Kundenschlüssel sieht ausschließlich\ndie Daten seines eigenen Kundenkontos.\n\n## Seitenweise Abfrage\n\nListen werden über einen Cursor geblättert, nicht über einen Offset. Jede Antwort\nenthält `next_cursor` und `has_more`; der Cursor ist die zuletzt gesehene ID.\nDadurch kann sich eine Seite nicht verschieben, während gelesen wird.\n\n## Fehler\n\nFehler folgen RFC 9457 und kommen als `application/problem+json` mit `type`,\n`title`, `status` und `detail`.\n\n## Beträge\n\nAlle Beträge sind ganzzahlige Cent, nie Kommazahlen, und tragen ihre Währung\nneben sich. `1999` bei `EUR` sind 19,99 €.\n\n---\n\nThe billing panel's REST API. Authenticate with an API key as a bearer token,\npage through lists with the opaque `cursor`, read errors as RFC 9457\nproblem documents, and treat every amount as integer minor units.",
        "contact": {
            "name": "virtify.net",
            "url": "https://virtify.net"
        }
    },
    "servers": [
        {
            "url": "/",
            "description": "Diese Instanz"
        }
    ],
    "tags": [
        {
            "name": "System",
            "description": "Erreichbarkeit und Fassung der Schnittstelle."
        },
        {
            "name": "Kunden",
            "description": "Kundenkonten: Stammdaten, Status und Kundennummer. Ein Kundenschlüssel sieht hier ausschließlich das eigene Konto."
        }
    ],
    "components": {
        "securitySchemes": {
            "ApiKey": {
                "type": "http",
                "scheme": "bearer",
                "description": "Ein API-Schlüssel aus dem Kunden- oder Verwaltungsbereich. Er wird genau einmal angezeigt und nur als Hash gespeichert."
            }
        },
        "schemas": {
            "Problem": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "description": "URI die den Fehlertyp benennt. `about:blank` heißt: der Statuscode sagt schon alles.",
                        "example": "https://virtify.net/problems/validation-failed"
                    },
                    "title": {
                        "type": "string",
                        "description": "Kurze, für den Typ stets gleiche Beschreibung.",
                        "example": "Die Anfrage war nicht gültig."
                    },
                    "status": {
                        "type": "integer",
                        "minimum": 100,
                        "maximum": 599,
                        "description": "Der HTTP-Statuscode, wiederholt im Körper.",
                        "example": 422
                    },
                    "detail": {
                        "type": "string",
                        "description": "Was in genau diesem Fall schiefging.",
                        "example": "`limit` muss zwischen 1 und 100 liegen."
                    },
                    "instance": {
                        "type": "string",
                        "description": "Die Anfrage, bei der es auftrat.",
                        "example": "/api/v1/invoices?limit=500"
                    },
                    "errors": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "path": {
                                    "type": "string",
                                    "example": "limit"
                                },
                                "message": {
                                    "type": "string",
                                    "example": "Höchstens 100."
                                }
                            },
                            "required": [
                                "path",
                                "message"
                            ]
                        },
                        "description": "Feldweise Begründung, wenn die Prüfung einer Eingabe fehlschlug."
                    }
                },
                "required": [
                    "type",
                    "title",
                    "status"
                ],
                "description": "Fehlerantwort nach RFC 9457, ausgeliefert als `application/problem+json`."
            },
            "Customer": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Technische ID des Kundenkontos.",
                        "example": "customer_01K9ZC4X7QG0VN3M8T6B2PFHRD"
                    },
                    "customer_number": {
                        "type": "integer",
                        "description": "Die Kundennummer, wie sie auf Rechnungen und im Schriftverkehr steht.",
                        "example": 10042
                    },
                    "kind": {
                        "type": "string",
                        "enum": [
                            "company",
                            "private"
                        ],
                        "description": "`company` für eine Firma, `private` für eine Privatperson. Entscheidet über Widerrufsrecht und, sobald die Regelbesteuerung aktiv ist, über die Umsatzsteuer.",
                        "example": "company"
                    },
                    "name": {
                        "type": "string",
                        "description": "Der Rechnungsempfänger: die Firma bei einer Firma, sonst die Person.",
                        "example": "Maria Musterfrau"
                    },
                    "company": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Firmenname, falls vorhanden.",
                        "example": "Beispiel GmbH"
                    },
                    "street": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Straße und Hausnummer.",
                        "example": "Musterweg 3"
                    },
                    "postal_code": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Postleitzahl.",
                        "example": "48145"
                    },
                    "city": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Ort.",
                        "example": "Münster"
                    },
                    "country": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Ländercode nach ISO 3166-1 alpha-2.",
                        "example": "DE"
                    },
                    "vat_id": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Umsatzsteuer-Identifikationsnummer.",
                        "example": "DE123456789"
                    },
                    "vat_id_validated_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "description": "Wann die USt-IdNr. zuletzt über VIES bestätigt wurde. `null` heißt: ungeprüft, also keine Grundlage für Reverse-Charge.",
                        "example": "2026-11-01T09:30:00.000Z"
                    },
                    "phone": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Telefonnummer für Rückfragen.",
                        "example": "+49 251 1234567"
                    },
                    "buyer_reference": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Käuferreferenz nach EN 16931 (BT-10), bei öffentlichen Auftraggebern die Leitweg-ID.",
                        "example": "04011000-12345-67"
                    },
                    "currency": {
                        "type": "string",
                        "description": "Währung des Kontos nach ISO 4217.",
                        "example": "EUR"
                    },
                    "language": {
                        "type": "string",
                        "enum": [
                            "de",
                            "en"
                        ],
                        "description": "Sprache für Dokumente und E-Mails.",
                        "example": "de"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "active",
                            "suspended",
                            "closed"
                        ],
                        "description": "`active` im Regelfall, `suspended` wenn Leistungen gesperrt sind, `closed` für beendete Konten.",
                        "example": "active"
                    },
                    "notes": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Interne Notiz. Nur für die Verwaltung; ein Kundenschlüssel sieht sie nicht.",
                        "example": "Zahlt zuverlässig, Rechnung bitte per Post."
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Anlagezeitpunkt in UTC.",
                        "example": "2026-01-15T10:00:00.000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Letzte Änderung in UTC.",
                        "example": "2026-11-07T08:15:00.000Z"
                    }
                },
                "required": [
                    "id",
                    "customer_number",
                    "kind",
                    "name",
                    "company",
                    "street",
                    "postal_code",
                    "city",
                    "country",
                    "vat_id",
                    "vat_id_validated_at",
                    "phone",
                    "buyer_reference",
                    "currency",
                    "language",
                    "status",
                    "notes",
                    "created_at",
                    "updated_at"
                ]
            },
            "CustomerPage": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Customer"
                        },
                        "description": "Die Zeilen dieser Seite, in ID-Reihenfolge."
                    },
                    "next_cursor": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "An die nächste Anfrage als `cursor` weitergeben; `null` auf der letzten Seite.",
                        "example": "invoice_01K9ZC4X7QG0VN3M8T6B2PFHRD"
                    },
                    "has_more": {
                        "type": "boolean",
                        "description": "Ob nach dieser Seite noch Zeilen folgen.",
                        "example": false
                    }
                },
                "required": [
                    "data",
                    "next_cursor",
                    "has_more"
                ]
            },
            "CustomerCreate": {
                "type": "object",
                "properties": {
                    "kind": {
                        "type": "string",
                        "enum": [
                            "company",
                            "private"
                        ],
                        "description": "`company` für eine Firma, `private` für eine Privatperson. Entscheidet über Widerrufsrecht und, sobald die Regelbesteuerung aktiv ist, über die Umsatzsteuer.",
